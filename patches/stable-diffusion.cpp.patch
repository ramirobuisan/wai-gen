+int sd_adetailer_detect(sd_adetailer_t* adetailer,
+                        const uint8_t* rgb,
+                        int width,
+                        int height,
+                        float confidence,
+                        float* boxes,
+                        int capacity) {
+    if (adetailer == nullptr || adetailer->detailer == nullptr || rgb == nullptr || width <= 0 || height <= 0) {
+        return -1;
+    }
+    ADetailerParams params;
+    params.confidence = confidence;
+    sd::Image image   = {static_cast<uint32_t>(width), static_cast<uint32_t>(height), 3, const_cast<uint8_t*>(rgb)};
+    auto detections   = adetailer->detailer->predict(image, params);
+    filter_and_sort_detections(&detections, width, height, params);
+    const int count = static_cast<int>(detections.size());
+    for (int i = 0; i < std::min(count, capacity); ++i) {
+        boxes[i * 5 + 0] = detections[i].x1;
+        boxes[i * 5 + 1] = detections[i].y1;
+        boxes[i * 5 + 2] = detections[i].x2;
+        boxes[i * 5 + 3] = detections[i].y2;
+        boxes[i * 5 + 4] = detections[i].confidence;
+    }
+    return count;
+}
