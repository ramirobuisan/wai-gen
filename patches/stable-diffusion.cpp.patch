+void sd_set_vae_hook(sd_ctx_t* ctx, sd_vae_hook_t hook, void* data) {
+    if (ctx == nullptr || ctx->sd == nullptr) {
+        return;
+    }
+    std::lock_guard<std::recursive_mutex> lock(ctx->sd->execution_mutex);
+    if (!ctx->sd->executing_) {
+        ctx->sd->vae_hook      = hook;
+        ctx->sd->vae_hook_data = data;
+    }
+}
+
+bool sd_set_diffusion_hook(sd_ctx_t* ctx, sd_diffusion_hook_t hook, void* data) {
+    if (ctx == nullptr || ctx->sd == nullptr) {
+        return false;
+    }
+    std::lock_guard<std::recursive_mutex> lock(ctx->sd->execution_mutex);
+    auto anima = std::dynamic_pointer_cast<Anima::AnimaRunner>(ctx->sd->diffusion_model);
+    if (ctx->sd->executing_ || !anima) {
+        return false;
+    }
+    anima->hook      = hook;
+    anima->hook_data = data;
+    return true;
+}
