+sd::Tensor<float> StableDiffusionGGML::run_vae_hook(int direction,
+                                                    const sd::Tensor<float>& input,
+                                                    std::vector<int64_t> output_shape) {
+    if (vae_hook == nullptr || input.dim() != 4) {
+        return {};
+    }
+    int64_t t0 = ggml_time_ms();
+    sd::Tensor<float> output(output_shape);
+    if (!vae_hook(direction, input.data(), input.shape().data(), output.data(), output.shape().data(), vae_hook_data)) {
+        LOG_WARN("external vae %s failed, using the built-in vae", direction == 0 ? "encode" : "decode");
+        return {};
+    }
+    LOG_INFO("external vae %s %lldx%lld completed, taking %.2fs", direction == 0 ? "encode" : "decode",
+             (long long)(direction == 0 ? input.shape()[0] : output_shape[0]),
+             (long long)(direction == 0 ? input.shape()[1] : output_shape[1]),
+             (ggml_time_ms() - t0) * 1.0f / 1000);
+    return output;
+}
