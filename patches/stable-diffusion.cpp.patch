+// External VAE for single images (WAI Gen patch). direction 0 = encode: input is an image [W,H,C,N]
+// (ggml order, i.e. NCHW in C order) with values in 0..1; output is the VAE latent [W/f,H/f,Cz,N]
+// before the model's latent normalization. direction 1 = decode: VAE latent in, image in 0..1 out.
+// The output buffer is preallocated with output_shape. Return false to use the built-in VAE.
+// Register/clear only while the context is idle. Passing NULL clears it.
+typedef bool (*sd_vae_hook_t)(int direction,
+                              const float* input,
+                              const int64_t* input_shape,
+                              float* output,
+                              const int64_t* output_shape,
+                              void* data);
+SD_API void sd_set_vae_hook(sd_ctx_t* ctx, sd_vae_hook_t hook, void* data);
+
+// External diffusion model (WAI Gen patch; Anima only for now): one forward pass of the model.
+// x: latent [W,H,C,N] (ggml order = NCHW in C order); timesteps: N values as the model receives them;
+// context: text-encoder states [D,L,N] (= [N][L][D] in C order); token_ids / token_weights: the adapter
+// inputs (n_tokens each, may be NULL). Write the prediction (same shape as x) to `output`.
+// Return false to run the built-in model. Returns false when the model doesn't support a hook.
+typedef bool (*sd_diffusion_hook_t)(const float* x,
+                                    const int64_t* x_shape,
+                                    const float* timesteps,
+                                    int64_t n_timesteps,
+                                    const float* context,
+                                    const int64_t* context_shape,
+                                    const int32_t* token_ids,
+                                    const float* token_weights,
+                                    int64_t n_tokens,
+                                    float* output,
+                                    void* data);
+SD_API bool sd_set_diffusion_hook(sd_ctx_t* ctx, sd_diffusion_hook_t hook, void* data);
