+void sd_set_vae_hook(sd_ctx_t* ctx, sd_vae_hook_t hook, void* data) {
+    if (ctx == nullptr || ctx->sd == nullptr) {
+        return;
+    }
+    std::lock_guard<std::recursive_mutex> lock(ctx->sd->execution_mutex);
+    if (!ctx->sd->executing_) {
+        ctx->sd->vae_hook      = hook;
+        ctx->sd->vae_hook_data = data;
+    }
+}
